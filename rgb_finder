#include <Adafruit_NeoPixel.h>
#include <math.h>

#define LED_PIN 6
#define NUM_LEDS 16
#define FRAME_MS 16 

Adafruit_NeoPixel strip(NUM_LEDS, LED_PIN, NEO_GRB + NEO_KHZ800);

// --- STRUCTURES ---
struct FlameProfile {
  uint32_t hotColor;
  uint32_t envColor;
  float kShape; 
  float ratioBase;
};

struct C { uint8_t r, g, b; };

// --- CONFIGURATION DES LEDS ---
const uint8_t px1 = 3; 
const uint8_t px2 = 2; 
const uint8_t px3 = 1; 

// --- PROFILS TESTÉS ---
FlameProfile Amber     = {0xFF9619, 0x5A1400, 1.3, 0.25};
FlameProfile Magnesium = {0xFFFAF0, 0x0005FF, 2.2, 0.15};
FlameProfile Cyan      = {0x28FFE6, 0x000AB4, 1.8, 0.2};
FlameProfile Potassium = {0xC864FF, 0x28005A, 2.0, 0.15};
FlameProfile Copper = {0x1EFEB4, 0x002805, 1.2, 0.2};

// Change ici pour tester :
FlameProfile currentProfile = Copper;

// --- VARIABLES D'ANIMATION (BLINK) ---
#define BASE_PERIOD_MS (700.0f / 6.0f)
#define PERIOD_JITTER  (260.0f / 6.0f)

float phaseAcc1 = 0.0f;
float phaseAcc2 = 0.0f;

// --- FONCTIONS DE CALCUL (MOTEUR GÉNÉRIQUE) ---

// Calcule une couleur spécifique pour un point 'z' (0.0 à 1.0) dans la flamme
C getFlameColor(FlameProfile p, float z) {
  float denom = 1.0 - exp(-p.kShape);
  float E = (denom != 0.0) ? (1.0 - exp(-p.kShape * z)) / denom : z;
  float heat = p.ratioBase + (1.0 - p.ratioBase) * E;

  float rh = (p.hotColor >> 16) & 0xFF;
  float gh = (p.hotColor >> 8) & 0xFF;
  float bh = p.hotColor & 0xFF;
  float re = (p.envColor >> 16) & 0xFF;
  float ge = (p.envColor >> 8) & 0xFF;
  float be = p.envColor & 0xFF;

  // Blending Linéaire pour la stabilité
  float r_f = re + (rh - re) * heat;
  float g_f = ge + (gh - ge) * heat;
  float b_f = be + (bh - be) * heat;

  // --- LES GARDES-FOUS (PROTECTION DES COULEURS) ---
  
  // 1. Anti-Pink / Anti-Purple (Magnesium)
  if (be > 150 && rh > 200) {
    float redThreshold = 0.5f; 
    r_f = (heat < redThreshold) ? 0 : rh * ((heat - redThreshold) / (1.0f - redThreshold));
    if (b_f > g_f) g_f = b_f * 1.05f; // Anchor Green to Blue for white
  }

  // 2. Green Guard (Copper / Cyan)
  if (gh > rh && g_f < b_f) {
    g_f = b_f * 1.1f;
  }

  // Glow Lift (Le petit boost de milieu de gamme)
  float lift = 1.0f + 0.2f * sin(M_PI * heat);
  
  // Perceptual Dimming & Shape (Appliqué ici pour le blink)
  float masterDim = 0.5f; 
  float shape = 0.4f + 0.6f * (0.5f * (1.0f + cos(M_PI * (1.0f - z))));

  return {
    (uint8_t)constrain(r_f * lift * masterDim * shape, 0, 255),
    (uint8_t)constrain(g_f * lift * masterDim * shape, 0, 255),
    (uint8_t)constrain(b_f * lift * masterDim * shape, 0, 255)
  };
}

// --- UTILS BLINK ---
static inline float clampf(float x, float lo, float hi){ return x<lo?lo:(x>hi?hi:x); }
static inline float lerpf(float a, float b, float t){ return a + (b-a)*t; }
static inline uint8_t lerp8(uint8_t a, uint8_t b, float t){
  return (uint8_t)constrain(lroundf(lerpf((float)a, (float)b, t)), 0, 255);
}
static inline float pulse01(float phase01){
  return 0.5f - 0.5f * cosf(phase01 * 2.0f * (float)M_PI);
}

float smoothPeriodMs(float t, float offset){
  float period = BASE_PERIOD_MS
               + PERIOD_JITTER * (0.65f * sinf(t * 0.70f + offset)
                                 + 0.35f * sinf(t * 0.33f + offset * 1.6f));
  return clampf(period, 380.0f / 6.0f, 1400.0f / 6.0f);
}

// --- SETUP & LOOP ---

void setup() {
  strip.begin();
  strip.clear();
  strip.setBrightness(255); // Le masterDim est géré dans getFlameColor
  strip.show();
}

void loop() {
  float t = millis() * 0.001f;

  // 1. On définit les 3 points de couleur du profil actuel
  C col1 = getFlameColor(currentProfile, 0.0f); // Base
  C col2 = getFlameColor(currentProfile, 0.5f); // Milieu
  C col3 = getFlameColor(currentProfile, 1.0f); // Sommet (Fixe)

  // 2. Animation LED 1 (Blink entre col1 et col2)
  float p1 = smoothPeriodMs(t, 1.3f);
  phaseAcc1 += (float)FRAME_MS / p1;
  if (phaseAcc1 >= 1.0f) phaseAcc1 -= 1.0f;
  float mix1 = pulse01(phaseAcc1);

  uint8_t r1 = lerp8(col1.r, col2.r, mix1);
  uint8_t g1 = lerp8(col1.g, col2.g, mix1);
  uint8_t b1 = lerp8(col1.b, col2.b, mix1);
  strip.setPixelColor(px1, strip.gamma32(strip.Color(r1, g1, b1)));

  // 3. Animation LED 2 (Blink entre col2 et col3)
  float p2 = smoothPeriodMs(t, 2.7f);
  phaseAcc2 += (float)FRAME_MS / p2;
  if (phaseAcc2 >= 1.0f) phaseAcc2 -= 1.0f;
  float mix2 = pulse01(phaseAcc2);

  uint8_t r2 = lerp8(col2.r, col3.r, mix2);
  uint8_t g2 = lerp8(col2.g, col3.g, mix2);
  uint8_t b2 = lerp8(col2.b, col3.b, mix2);
  strip.setPixelColor(px2, strip.gamma32(strip.Color(r2, g2, b2)));

  // 4. LED 3 fixe (Cœur de flamme)
  strip.setPixelColor(px3, strip.gamma32(strip.Color(col3.r, col3.g, col3.b)));

  strip.show();
  delay(FRAME_MS);
}
